{
  "models": [
    {
      "id": "page-metadata",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:title",
          "label": "Title"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "navigation-title",
          "label": "Navigation Title",
          "description": "Optional. Used as a shorter label in navigation surfaces such as breadcrumbs."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "breadcrumb-title",
          "label": "Breadcrumb Title",
          "description": "Optional. Overrides Navigation Title and page title when this page appears in breadcrumbs."
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "breadcrumb-visible",
          "label": "Include in Breadcrumb",
          "description": "When disabled, this page is skipped when it is used as an intermediate breadcrumb level.",
          "value": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "jcr:description",
          "label": "Description"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "keywords",
          "multi": true,
          "label": "Keywords"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "meta-title",
          "label": "Meta Title (SEO)"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "meta-description",
          "label": "Meta Description (SEO)"
        },
        {
          "component": "aem-content",
          "name": "nav",
          "label": "Header Fragment Path"
        },
        {
          "component": "aem-content",
          "name": "footer",
          "label": "Footer Fragment Path"
        },
        {
          "component": "select",
          "name": "page-type",
          "label": "Page Type",
          "value": "default",
          "options": [
            {
              "name": "Default",
              "value": "default"
            },
            {
              "name": "Home",
              "value": "home"
            },
            {
              "name": "Category",
              "value": "category"
            },
            {
              "name": "Tag",
              "value": "tag"
            },
            {
              "name": "Article",
              "value": "article"
            },
            {
              "name": "Fragment",
              "value": "fragment"
            }
          ]
        },
        {
          "component": "select",
          "name": "inspiration-data-mode",
          "label": "Inspiration Data Mode",
          "value": "aem",
          "options": [
            {
              "name": "AEM",
              "value": "aem"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "article-internal-name",
          "label": "Article Internal Name",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "article-image",
          "label": "Article Image",
          "multi": false,
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "article-image-alt",
          "label": "Article Image Alt",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "article-author-name",
          "label": "Article Author Name",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "article-author-description",
          "label": "Article Author Description",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "article-author-image",
          "label": "Article Author Image",
          "multi": false,
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "article-category",
          "label": "Primary Category",
          "multi": false
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "article-tags",
          "label": "Tags",
          "condition": {
            "or": [
              {
                "==": [
                  {
                    "var": "page-type"
                  },
                  "article"
                ]
              },
              {
                "==": [
                  {
                    "var": "page-type"
                  },
                  "tag"
                ]
              },
              {
                "==": [
                  {
                    "var": "page-type"
                  },
                  "category"
                ]
              }
            ]
          }
        },
        {
          "component": "date-time",
          "valueType": "date",
          "name": "article-publication-date",
          "label": "Article Publication Date",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "date-time",
          "valueType": "date",
          "name": "article-update-date",
          "label": "Article Update Date",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "article-read-time",
          "label": "Article Read Time",
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "article-visible",
          "label": "Article Visible",
          "value": true,
          "condition": {
            "==": [
              {
                "var": "page-type"
              },
              "article"
            ]
          }
        }
      ]
    }
  ]
}
