{
  "definitions": [
    {
      "title": "Article Content - Video",
      "id": "article-content-video",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Article Content Video",
              "model": "article-content-video"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "article-content-video",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "videoType",
          "label": "Video Type",
          "value": "dam",
          "options": [
            { "name": "DAM", "value": "dam" },
            { "name": "YouTube", "value": "youtube" }
          ]
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "videoDam",
          "label": "Video DAM",
          "description": "Select an AEM DAM video reference or contribute a direct video URL.",
          "condition": {
            "==": [
              {
                "var": "videoType"
              },
              "dam"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "youtubeVideoId",
          "label": "YouTube Video (ID or URL)",
          "value": "",
          "condition": {
            "==": [
              {
                "var": "videoType"
              },
              "youtube"
            ]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "poster",
          "label": "Poster Image (optional)",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "posterAlt",
          "label": "Poster Alt Text (optional)",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "caption",
          "label": "Caption (optional)",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "alignment",
          "label": "Alignment",
          "value": "center",
          "options": [
            { "name": "Center", "value": "center" },
            { "name": "Left", "value": "left" },
            { "name": "Right", "value": "right" }
          ]
        }
      ]
    }
  ],
  "filters": []
}
